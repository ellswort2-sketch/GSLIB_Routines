$('csv').onclick=()=>save('Kriging_Results.csv',cols.join(',')+'\n'+result.rows.map(r=>cols.map(k=>r[k]??'').join(',')).join('\n'),'text/csv');
$('geo').onclick=()=>{const c=cols.filter(c=>c!=='status');save('Kriging_Results.dat','KT3D browser estimates · unestimated = -999\n'+c.length+'\n'+c.join('\n')+'\n'+result.rows.map(r=>c.map(k=>r[k]??-999).join(' ')).join('\n'));};
$('settings').onclick=()=>save('Kriging_Settings.json',JSON.stringify(config,null,2),'application/json');
$('png').onclick=()=>{const a=document.createElement('a');a.download='Kriging_Map.png';a.href=$('map').toDataURL();a.click();};
['x','y','z','xx','yy','zz','xy','xz','yz'].forEach(k=>{const label=document.createElement('label'),i=document.createElement('input');i.type='checkbox';i.setAttribute('aria-label','Polynomial drift '+k);label.append(i,k);$('drifts').append(label);});
document.querySelectorAll('main input,main select').forEach(e=>{if(e.type==='file')return;e.addEventListener('change',()=>{if(['display','slice','samples'].includes(e.id)){draw();return;}dirty();mode();sillInfo();});});
$('structures').addEventListener('change',()=>{dirty();sillInfo();});
models([{type:1,sill:200,major:100,minor:100,vertical:100,az:0,dip:0,roll:0}]);mode();
</script></body></html>
